# Порти сервісів
APP_PORT=3000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=change_me
MONGO_DB=combats

# Панель керування Mongo Express (аналог phpMyAdmin)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=change_me

# Безпека та дефолтний адміністратор гри
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_min_8
